# PostgreSQL. Locally both URLs are the same.
# Supabase: Project → Connect →
#   DATABASE_URL = "Transaction pooler" URI (port 6543) + "?pgbouncer=true"
#   DIRECT_URL   = "Session pooler" (or direct) URI (port 5432) — used by migrations
DATABASE_URL="postgresql://crm:crm@localhost:5432/growthavenues?schema=public"
DIRECT_URL="postgresql://crm:crm@localhost:5432/growthavenues?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# File storage: "local" (files under UPLOAD_DIR) or "supabase" (private bucket).
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""   # server-side only, never expose to the browser
# SUPABASE_BUCKET="crm-documents"

# Business timezone for "today", date filters and displayed times.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Shared secret for scheduled jobs (POST /api/cron/notifications).
CRON_SECRET=""

# Website forms (beipoready.com) → POST /api/public/leads with this key.
WEBSITE_API_KEY=""
# Browser origins allowed to call it directly (comma-separated).
WEBSITE_ALLOWED_ORIGINS="https://beipoready.com,https://www.beipoready.com"

# Google (Gmail + Calendar/Meet) and Microsoft (Outlook + Teams) OAuth apps.
# Redirect URIs: <NEXTAUTH_URL>/api/integrations/google/callback and …/microsoft/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
# Optional: separate key for encrypting stored OAuth tokens (defaults to NEXTAUTH_SECRET).
TOKEN_ENCRYPTION_KEY=""
